# FalkorDB (local docker compose or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
RIPPLE_DEFAULT_TENANT=handbook-demo
# Fixed clock in epoch ms for demo mode (empty = real time). 1784048400000 = 2026-07-14 17:00 UTC, just after C1
RIPPLE_NOW_MS=

# Optional LLM (only for Concierge phrasing and fact proposals; demo path is deterministic)
LLM_PROVIDER=
LLM_API_KEY=

# Web
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:8000
